{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "secrets": {
      "$code": {
        "$uid": {
          ".read": "auth != null && (auth.uid === $uid || root.child('rooms').child($code).child('meta/players').child(auth.uid).child('role').val() === 'spectator')",
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    }
  }
}
