{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "secrets": {
      "$code": {
        "$uid": {
          ".read": "auth != null && (auth.uid === $uid || root.child('rooms').child($code).child('meta/players').child(auth.uid).child('role').val() === 'spectator' || (root.child('rooms').child($code).child('meta/host').val() === auth.uid && root.child('rooms').child($code).child('meta/players').child($uid).child('cpu').val() === true))",
          ".write": "auth != null && (auth.uid === $uid || (root.child('rooms').child($code).child('meta/host').val() === auth.uid && root.child('rooms').child($code).child('meta/players').child($uid).child('cpu').val() === true))"
        }
      }
    }
  }
}
